# --- Required ---------------------------------------------------------------

# Google Gemini API key. Get one for free at https://aistudio.google.com/.
GOOGLE_API_KEY=your_google_api_key_here

# Admin API key - full access to upload, delete, rebuild, destroy and query.
# Generate a random one, e.g. `openssl rand -hex 32`. The server refuses to
# start if this is unset.
API_ADMIN_KEY=change-me-to-a-long-random-string


# --- Optional: public (query-only) key for embedding in a website ----------

# When set, this key may call POST /api/v1/brains/{brain}/query, but
# nothing else. Safe to ship to a website client if combined with a
# CORS allowlist and rate limiting at your edge. Leave empty to require
# the admin key for every request.
# API_PUBLIC_KEY=


# --- Optional: header name --------------------------------------------------
# API_KEY_HEADER=X-API-Key


# --- Optional: CORS ---------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" only in development.
# CORS_ORIGINS=https://your-site.example,https://staging.your-site.example


# --- Optional: model / generation ------------------------------------------
# MODEL_NAME=models/gemini-3.5-flash
# EMBEDDING_MODEL=models/gemini-embedding-001
# TEMPERATURE=0.0
# MAX_OUTPUT_TOKENS=1024
# MAX_ANSWER_CHARS=2000

# Thinking-token budget for Gemini 2.5 / 3.x.
#   0  = disabled  (default; cheapest, lowest latency, recommended for RAG)
#   -1 = dynamic   (model decides; can spend many tokens "reasoning")
#   N  = up to N tokens of internal reasoning
# THINKING_BUDGET=0


# --- Optional: retrieval / chunking ----------------------------------------
# CHUNK_SIZE=900
# CHUNK_OVERLAP=120
# RETRIEVAL_K=6

# Distance threshold above which the assistant refuses to answer. Lower =
# stricter ("I don't know" more often). ChromaDB uses cosine distance
# (0 = identical, 2 = opposite).
# GROUNDING_MAX_DISTANCE=0.95


# --- Optional: limits -------------------------------------------------------
# MAX_UPLOAD_BYTES=26214400      # 25 MiB
# MAX_QUESTION_CHARS=2000
# MAX_FILENAME_CHARS=200


# --- Optional: branding -----------------------------------------------------
# Appears in the assistant's refusal messages. Keep it short.
# SITE_NAME=Example Foundation
